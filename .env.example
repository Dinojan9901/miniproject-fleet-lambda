# Copy to .env to override any default. Docker Compose reads .env automatically.
# Every value here is consumed by common/config.py -- nothing else reads the
# environment directly.

# --- Simulated clock -------------------------------------------------------
# Real seconds that make up one simulated day. 300 = 288x compression, so a
# simulated hour passes every 12.5 real seconds and Airflow reconciles a full
# day every 5 minutes. Lower it to 120 for a faster demo; raise it to slow down.
SIM_DAY_SECONDS=300
SIM_EPOCH_DATE=2026-08-01

# --- Simulation shape ------------------------------------------------------
FLEET_SIZE=12
EVENT_INTERVAL_SECONDS=2.0
# Fraction of telemetry deliberately malformed, to exercise validation and
# quarantine. Raise to 0.3 to make the Grafana quarantine panel obvious.
ANOMALY_RATE=0.04

# --- Speed layer -----------------------------------------------------------
# Both are in *simulated* minutes: 60 simulated minutes is 12.5 real seconds.
WINDOW_MINUTES=60
WATERMARK_MINUTES=30
IDLE_ALERT_MINUTES=45

LOG_LEVEL=INFO
